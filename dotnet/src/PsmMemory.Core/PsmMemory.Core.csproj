<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PsmMemory.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>chkrishna2001</Authors>
    <Description>Local-first SDK for PSM Memory storage, grounded recall, consolidation, and model-backed memory decisions, backed by an in-process ONNX Runtime GenAI model with swappable LoRA adapters.</Description>
    <PackageTags>ai-memory;agent-memory;local-first;sqlite;onnxruntime-genai;llm</PackageTags>
    <RepositoryUrl>https://github.com/chkrishna2001/PSM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.10 pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a known
         high-severity advisory (GHSA-2m69-gcr7-jv3q). Pin the fixed version directly. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.14.1" />
  </ItemGroup>

</Project>
