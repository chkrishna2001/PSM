<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PsmMemory.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>chkrishna2001</Authors>
    <Description>Local-first SDK for PSM Memory storage, grounded recall, consolidation, and model-backed memory decisions, backed by an in-process llama.cpp (GGUF) model with swappable LoRA adapters.</Description>
    <PackageTags>ai-memory;agent-memory;local-first;sqlite;llama.cpp;llm</PackageTags>
    <RepositoryUrl>https://github.com/chkrishna2001/PSM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.10 pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a known
         high-severity advisory (GHSA-2m69-gcr7-jv3q). Pin the fixed version directly. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <!-- LLamaSharp (llama.cpp binding): unlike onnxruntime-genai's single-RID-locks-one-backend
       model, LLamaSharp lets multiple native backends ship side by side in one build and
       self-selects the right one for the machine it actually runs on. LlamaSharpPsmRuntime just
       requests GpuLayerCount = -1 (try to offload everything) and llama.cpp itself falls back to
       partial/full CPU automatically if no compatible GPU backend loaded or VRAM is insufficient.
       Cpu is the universal baseline (bundles Metal support on macOS); Vulkan gives broad GPU
       coverage (NVIDIA/AMD/Intel) on Windows/Linux without requiring a separate CUDA Toolkit
       install. Cuda12 is bundled too for linux: verified on a RunPod GPU pod that its base image
       ships the CUDA toolkit/driver but NOT the Vulkan userspace (loader + ICD), so Vulkan alone
       would silently fall back to CPU there. Both native libs ship side by side; whichever one
       actually loads on a given machine wins, so this doesn't regress machines that do have Vulkan. -->
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or $(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" />
  </ItemGroup>

</Project>
